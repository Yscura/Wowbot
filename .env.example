# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID
CHANNEL_ID=

# Optional: comma-separated RSS feeds. Add https://www.wowhead.com/news/rss/retail for regular WoW news too.
FEEDS=https://www.wowhead.com/news/rss/forever

# Optional: minutes between checks
POLL_MINUTES=10

# Optional: how many existing articles to post the very first time the bot runs
INITIAL_POSTS=3

# --- Webhook mode (webhook.py / GitHub Actions) ---
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# For GitHub Actions, add this as a repository secret named WEBHOOK_URL instead.
WEBHOOK_URL=
